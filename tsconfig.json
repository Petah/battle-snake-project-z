{
    "include": [
        "src/**/*.ts"
    ],
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "strict": false,
        "types": [
            "node"
        ],
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true
    }
}
