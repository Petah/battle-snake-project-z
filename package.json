{
    "name": "battlesnake-project-z",
    "description": "Project Z BattleSnake AI",
    "version": "0.0.0",
    "private": true,
    "dependencies": {
        "@rushstack/ts-command-line": "^5.3.15",
        "crc-32": "^1.2.2",
        "express": "^5.2.1",
        "js-md5": "^0.9.2",
        "morgan": "^1.12.1",
        "pathfinding": "https://codeload.github.com/paulrobello/PathFinding.js/tar.gz/3840d6e60b88a71c38ee5c356542b4a5883f3444",
        "websocket": "^1.0.35"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.6",
        "@types/websocket": "^1.0.10",
        "cheerio": "^1.2.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "eslint-plugin-svelte": "^3.23.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.2"
    },
    "main": "dist/server/index.js",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc && npm run build:web",
        "build:web": "node scripts/build-web.mjs",
        "watch:web": "node scripts/build-web.mjs --watch",
        "start": "node dist/server/index.js",
        "server": "npm start",
        "dev": "npm run build && concurrently --kill-others --names SERVER,DASHBOARD,TYPES,WEB \"tsx watch src/server/index.ts\" \"tsx watch src/dashboard/index.ts\" \"tsc --watch --preserveWatchOutput\" \"npm run watch:web\"",
        "typecheck": "tsc --noEmit && npm run check:web",
        "lint": "eslint src scripts ui eslint.config.mjs --max-warnings 0",
        "test": "npm run build && node --test tests/*.test.mjs",
        "profile:movement": "node scripts/profile-movement.mjs",
        "dashboard": "node dist/dashboard/index.js",
        "evaluate": "npm run build && node dist/evaluation/index.js",
        "check:web": "cd ui && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    }
}
