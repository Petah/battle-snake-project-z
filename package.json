{
    "name": "battlesnake-project-z",
    "description": "Project Z BattleSnake AI",
    "version": "0.0.0",
    "private": true,
    "dependencies": {
        "crc-32": "^1.2.2",
        "express": "^5.2.1",
        "morgan": "^1.12.1",
        "pathfinding": "https://codeload.github.com/paulrobello/PathFinding.js/tar.gz/3840d6e60b88a71c38ee5c356542b4a5883f3444",
        "websocket": "^1.0.35"
    },
    "devDependencies": {
        "@types/angular": "^1.8.9",
        "@types/express": "^5.0.6",
        "@types/jquery": "^3.5.34",
        "@types/node": "^24.13.6",
        "@types/websocket": "^1.0.10",
        "concurrently": "^10.0.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    },
    "main": "dist/server/index.js",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc && npm run build:web",
        "build:web": "node scripts/build-web.mjs",
        "watch:web": "node scripts/build-web.mjs --watch",
        "start": "node dist/server/index.js",
        "server": "npm start",
        "dev": "npm run build && concurrently --kill-others --names SERVER,TYPES,WEB \"tsx watch src/server/index.ts\" \"tsc --watch --preserveWatchOutput\" \"npm run watch:web\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src scripts eslint.config.mjs",
        "test": "npm run build && node --test tests/*.test.mjs"
    }
}
